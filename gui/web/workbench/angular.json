{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm",
    "cache": { "path": "../../../build/gui-workbench-cache" }
  },
  "projects": {
    "workbench": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "outputPath": "../../../build/gui-workbench",
            "optimization": {
              "scripts": true,
              "styles": { "minify": true, "inlineCritical": false },
              "fonts": false
            },
            "outputHashing": "all",
            "allowedCommonJsDependencies": ["@vehicle-sil/gui-client/timeline"]
          }
        }
      }
    }
  }
}
