{
  "name": "vehicle-sil-gui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:client": "tsc -p ../client && vitest run --dir ../client --environment node --globals",
    "lint": "ng lint && eslint ../client",
    "build:client": "node node_modules/esbuild/bin/esbuild ../client/src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=../../build/gui-client/vehicle-sil-gui-client.mjs",
    "e2e": "playwright test",
    "e2e:dev": "playwright test -c playwright.dev.config.ts",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "format:check": "prettier --check . ../client",
    "i18n:extract": "ng extract-i18n --format json --output-path ../../build/i18n"
  },
  "engines": {
    "node": "^24.15.0 || ^26.0.0",
    "npm": ">=11.12.1"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.7",
    "@angular/common": "~22.2.5",
    "@angular/compiler": "~22.2.5",
    "@angular/core": "~22.2.5",
    "@angular/forms": "~22.2.5",
    "@angular/localize": "~22.2.5",
    "@angular/material": "~22.2.7",
    "@angular/platform-browser": "~22.2.5",
    "@angular/router": "~22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/compiler-cli": "~22.2.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
