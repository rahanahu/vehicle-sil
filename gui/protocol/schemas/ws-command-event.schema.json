        },
        "source": {
          "enum": [
            "stdin",
            "eof",
            "control_server",
            "api"
          ],
          "title": "Source",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "title": "Message"
        },
        "id": {
          "anyOf": [
            {
              "maximum": 9007199254740992,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "command": {
          "const": "step",
          "title": "Command",
          "type": "string"
        },
        "accepted": {
          "const": true,
          "title": "Accepted",
          "type": "boolean"
        },
        "reason": {
          "const": null,
          "title": "Reason",
          "type": "null"
        },
        "ms": {
          "minimum": 1,
          "type": "integer",
          "title": "Ms"
        },
        "at_ms": {
          "minimum": 0,
          "type": "integer",
          "title": "At Ms"
        }
      },
      "required": [
        "event",
        "seq",
        "source",
        "message",
        "id",
        "command",
        "accepted",
        "reason"
      ],
      "title": "AcceptedStepCommandEvent",
      "type": "object"
    },
    "RefusedCommandEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "command",
          "title": "Event",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "t_ms": {
          "minimum": 0,
          "type": "integer",
          "title": "T Ms"
        },
        "run": {
          "minLength": 1,
          "type": "string",
