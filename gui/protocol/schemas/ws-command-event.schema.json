        "message": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "title": "Message"
        },
        "id": {
          "anyOf": [
            {
              "maximum": 9007199254740992,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "command": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "title": "Command"
        },
        "accepted": {
          "const": false,
          "title": "Accepted",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "title": "Reason"
        },
        "asked_run": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "default": null,
          "title": "Asked Run"
        }
      },
      "required": [
        "event",
        "seq",
        "source",
        "message",
        "id",
        "command",
        "accepted",
        "reason"
      ],
      "title": "RefusedCommandEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "event",
      "title": "Type",
      "type": "string"
    },
    "stream_seq": {
      "minimum": 0,
      "title": "Stream Seq",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "event": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceptedOtherCommandEvent"
        },
        {
          "$ref": "#/$defs/AcceptedStepCommandEvent"
        },
