{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vehicle-sil GUI WebSocket command event message (Protocol v4)",
  "description": "Validates a GUI server WebSocket `event` message carrying a launcher `command` event (Events v4 / Protocol v4). Enforces accepted vs. refused conditional rules (accepted events require a non-empty command, `reason: null`, forbid `asked_run`, and allow `ms` only for `step`; refused events forbid `ms` and `at_ms`).",
  "$defs": {
    "AcceptedOtherCommandEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "command",
          "title": "Event",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "t_ms": {
          "minimum": 0,
          "type": "integer",
          "title": "T Ms"
        },
        "run": {
          "minLength": 1,
          "type": "string",
          "title": "Run"
        },
        "source": {
          "enum": [
            "stdin",
            "eof",
            "control_server",
            "api"
          ],
          "title": "Source",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "title": "Message"
        },
        "id": {
          "anyOf": [
            {
              "maximum": 9007199254740992,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "accepted": {
          "const": true,
          "title": "Accepted",
          "type": "boolean"
        },
        "reason": {
          "const": null,
          "title": "Reason",
          "type": "null"
        },
        "at_ms": {
          "minimum": 0,
          "type": "integer",
          "title": "At Ms"
        }
      },
      "required": [
        "event",
        "seq",
        "source",
        "message",
        "id",
        "command",
        "accepted",
        "reason"
      ],
      "title": "AcceptedOtherCommandEvent",
      "type": "object"
    },
    "AcceptedStepCommandEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "command",
          "title": "Event",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "t_ms": {
          "minimum": 0,
          "type": "integer",
          "title": "T Ms"
        },
        "run": {
          "minLength": 1,
