{
  "description": "The server, the launcher it found, and the limits.",
  "request": {
    "method": "GET",
    "path": "api/app"
  },
  "status": 200,
  "response": {
    "vehicle_sil_gui": 3,
    "version": "<version>",
    "instance": "0123456789abcdef",
    "root": "/path/to/root",
    "initial_file": null,
    "launcher": {
      "path": "/path/to/vehicle_sil_launch",
      "usable": true,
      "problems": [],
      "version": {
        "vehicle_sil_launch": 1,
        "vehicle_sil": "<version>",
        "formats": {
          "check": 1,
          "run": 2,
          "events": 2,
          "describe": 1,
          "test": 1,
          "timeline": 1,
          "connections": 1
        },
        "features": [
          "events",
          "stdin-commands",
          "check-variables",
          "speed",
          "start-paused",
          "time-commands",
          "control-links",
          "scenario",
          "manual-participants",
          "scenario-wave",
          "scenario-motion-expect",
          "scenario-points-file",
          "timeline",
          "timeline-lines",
          "scenario-inputs",
          "network-names",
          "run-traffic",
          "j1939-nodes",
          "connect",
          "connections",
          "connect-counts",
          "state",
          "time-policy",
          "stdin-run-until",
          "request",
          "scenario-samples",
          "run-stop-at",
          "scenario-control",
          "scenario-time"
        ]
      }
    },
    "variables": {
      "available": false,
      "reason": "this launcher was built without a control server, so the variables of the ECUs cannot be read"
    },
    "limits": {
      "log_lines_per_source": 2000,
      "check_timeout_s": 120,
      "speed_min": 1e-06,
      "speed_max": 1000000.0,
      "step_ms_max": 1000000000000,
      "watches": 16,
      "watch_variables": 2000,
      "watch_period_ms_min": 20,
      "watch_period_ms_max": 60000,
      "writes_per_request": 256,
      "write_at_ms_max": 1000000000000,
      "write_timeout_s": 5.0
    }
  }
}
