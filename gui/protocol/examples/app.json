{
  "description": "The server, the launcher it found, and the limits.",
  "request": {
    "method": "GET",
    "path": "api/app"
  },
  "status": 200,
  "response": {
    "vehicle_sil_gui": 1,
    "version": "0.1.0",
    "instance": "0123456789abcdef",
    "root": "/path/to/root",
    "initial_file": null,
    "launcher": {
      "path": "/path/to/vehicle_sil_launch",
      "usable": true,
      "problems": [],
      "version": {
        "vehicle_sil_launch": 1,
        "vehicle_sil": "0.1.0",
        "formats": {
          "check": 1,
          "run": 1,
          "events": 1,
          "describe": 1
        },
        "features": [
          "events",
          "stdin-commands",
          "check-variables",
          "speed",
          "start-paused",
          "time-commands",
          "control-links",
          "scenario",
          "manual-participants"
        ]
      }
    },
    "variables": {
      "available": false,
      "reason": "this vehicle_sil_launch has no 'control-server' (its features: events, stdin-commands, check-variables, speed, start-paused, time-commands, control-links, scenario, manual-participants): build it with -DVEHICLE_SIL_BUILD_CONTROL_SERVER=ON (docs/control-api.md)"
    },
    "limits": {
      "log_lines_per_source": 2000,
      "check_timeout_s": 120,
      "speed_min": 1e-06,
      "speed_max": 1000000.0,
      "step_ms_max": 1000000000000,
      "watches": 16,
      "watch_variables": 2000,
      "watch_period_ms_min": 20,
      "watch_period_ms_max": 60000,
      "writes_per_request": 256,
      "write_at_ms_max": 1000000000000,
      "write_timeout_s": 5.0
    }
  }
}
