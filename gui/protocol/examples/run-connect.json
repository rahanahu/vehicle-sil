{
  "description": "Start a run with ETH_EXT connected to a listed target.",
  "request": {
    "method": "POST",
    "path": "api/run",
    "body": {
      "file": "connect.yaml",
      "connect": {
        "ETH_EXT": "fake0"
      },
      "stop_at_ms": 1000
    }
  },
  "status": 200,
  "response": {
    "instance": "0123456789abcdef",
    "run_id": "1"
  }
}
