{
  "description": "Ask the run to stop without waiting (a second stop to the launcher).",
  "request": {
    "method": "POST",
    "path": "api/stop-session",
    "body": {
      "run_id": "1",
      "instance": "0123456789abcdef",
      "force": true
    }
  },
  "status": 200,
  "response": {
    "instance": "0123456789abcdef",
    "run_id": "1"
  }
}
