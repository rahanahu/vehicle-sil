{
  "description": "A time command: passed on to the launcher at once (what it did comes as its command and time events).",
  "request": {
    "method": "POST",
    "path": "api/time",
    "body": {
      "command": "step",
      "ms": 25,
      "run_id": "1",
      "instance": "0123456789abcdef"
    }
  },
  "status": 200,
  "response": {
    "run_id": "1",
    "command": {
      "command": "step",
      "ms": 25
    }
  }
}
