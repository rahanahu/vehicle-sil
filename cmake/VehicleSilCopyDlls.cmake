#
# Script mode (cmake -P): copies runtime DLLs passed after `--` into DEST_DIR under a
# process-level lock keyed by DEST_DIR so parallel Ninja builds never collide on Windows.
#
# Usage:
#   cmake -DDEST_DIR=<dir> [-DLOCK_DIR=<dir>] -P VehicleSilCopyDlls.cmake -- [<dll> ...]
cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED DEST_DIR OR "${DEST_DIR}" STREQUAL "")
  message(FATAL_ERROR "VehicleSilCopyDlls.cmake: -DDEST_DIR=<dir> is required")
endif()

set(_after_script FALSE)
set(_skip_script_arg FALSE)
set(_after_sep FALSE)
set(_raw_dlls "")
math(EXPR _last_arg "${CMAKE_ARGC} - 1")
foreach(_i RANGE 0 ${_last_arg})
  set(_arg "${CMAKE_ARGV${_i}}")
  if(_after_sep)
    if(NOT _arg STREQUAL "")
      list(APPEND _raw_dlls "${_arg}")
    endif()
  elseif(_skip_script_arg)
    set(_skip_script_arg FALSE)
    set(_after_script TRUE)
  elseif(NOT _after_script)
    if(_arg STREQUAL "-P")
      set(_skip_script_arg TRUE)
    endif()
  elseif(_arg STREQUAL "--")
    set(_after_sep TRUE)
  else()
    message(FATAL_ERROR "VehicleSilCopyDlls.cmake: unexpected argument '${_arg}' before '--' (pass DLL paths after '--')")
  endif()
endforeach()

set(_dlls "")
set(_seen_names "")
foreach(_dll IN LISTS _raw_dlls)
  cmake_path(SET _norm_dll NORMALIZE "${_dll}")
  cmake_path(GET _norm_dll FILENAME _name)
  string(TOLOWER "${_name}" _name_key)
  if(NOT _name_key IN_LIST _seen_names)
    list(APPEND _seen_names "${_name_key}")
    list(APPEND _dlls "${_norm_dll}")
  endif()
endforeach()

# Static builds (VEHICLE_SIL_STATIC=ON) and targets without runtime DLLs pass nothing after `--`:
# exit without creating a lock file or touching DEST_DIR.
if(NOT _dlls)
  return()
endif()

cmake_path(SET _dest_dir NORMALIZE "${DEST_DIR}")
cmake_path(ABSOLUTE_PATH _dest_dir NORMALIZE)
string(REGEX REPLACE "/+$" "" _dest_key "${_dest_dir}")
if(WIN32)
  string(TOLOWER "${_dest_key}" _dest_key)
endif()
string(SHA256 _dest_hash "${_dest_key}")

if(DEFINED LOCK_DIR AND NOT "${LOCK_DIR}" STREQUAL "")
  cmake_path(SET _lock_dir NORMALIZE "${LOCK_DIR}")
  cmake_path(ABSOLUTE_PATH _lock_dir NORMALIZE)
else()
  set(_lock_dir "${_dest_dir}")
endif()
file(MAKE_DIRECTORY "${_lock_dir}")

set(_lock_file "${_lock_dir}/vehicle_sil_dll_${_dest_hash}.lock")
file(LOCK "${_lock_file}" GUARD PROCESS RESULT_VARIABLE _lock_result TIMEOUT 60)
if(NOT _lock_result STREQUAL "0")
  message(FATAL_ERROR "VehicleSilCopyDlls.cmake: failed to acquire lock ${_lock_file}: ${_lock_result}")
endif()

file(MAKE_DIRECTORY "${_dest_dir}")
foreach(_dll IN LISTS _dlls)
  if(NOT EXISTS "${_dll}" OR IS_DIRECTORY "${_dll}")
    message(FATAL_ERROR "VehicleSilCopyDlls.cmake: runtime DLL not found: ${_dll}")
  endif()
  cmake_path(GET _dll FILENAME _name)
  set(_dst "${_dest_dir}/${_name}")
  if(EXISTS "${_dst}")
    file(REAL_PATH "${_dll}" _src_real)
    file(REAL_PATH "${_dst}" _dst_real)
    if(_src_real STREQUAL _dst_real)
      continue()
    endif()
  endif()
  file(COPY_FILE "${_dll}" "${_dst}" ONLY_IF_DIFFERENT RESULT _copy_result)
  if(NOT _copy_result STREQUAL "0")
    message(FATAL_ERROR "VehicleSilCopyDlls.cmake: failed to copy ${_dll} to ${_dst}: ${_copy_result}")
  endif()
endforeach()
